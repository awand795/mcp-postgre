APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mcp_postgresql
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# ── Wajib diset ke nilai ini saat deploy production dengan HTTPS ──
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=none
SESSION_PARTITIONED_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# MCP PostgreSQL Configuration
DB_MBI_CONNECTION=pgsql_mbi
DB_MBI_HOST=127.0.0.1
DB_MBI_PORT=5432
DB_MBI_DATABASE=data_mbi
DB_MBI_USERNAME=postgres
DB_MBI_PASSWORD=

# AI Model Configuration (OpenRouter)
# Qwen models are recommended for best analysis performance:
# - qwen/qwen-2.5-coder-32b-instruct (Primary - optimized for SQL/code analysis)
# - qwen/qwen-2.5-72b-instruct (Fallback - general purpose large model)
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# MCP Client Configuration (chatbot sebagai MCP client)
# mode: "direct" (in-process, paling cepat) atau "http" (via HTTP ke MCP server)
MCP_CLIENT_MODE=direct
# URL MCP server (hanya digunakan jika MCP_CLIENT_MODE=http)
MCP_SERVER_INTERNAL_URL=http://127.0.0.1:8000/mcp
# Bearer token untuk autentikasi ke MCP server (hanya jika mode=http)
MCP_SERVER_INTERNAL_TOKEN=

# ── SSO Configuration (untuk integrasi dengan ERP via iframe) ────────────────────
# Kunci rahasia yang SAMA harus diset di backend ERP sebagai CHATBOT_SSO_KEY
# Generate dengan: php artisan key:generate --show (atau pakai random string 64 char)
SSO_API_KEY=ganti_dengan_string_acak_minimal_32_karakter_yang_kuat
