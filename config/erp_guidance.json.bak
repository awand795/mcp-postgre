                    "field": "Tran Pembelian",
                    "description": "Pilih transaksi pembelian yang akan dikurang nilai hutangnya."
                },
                {
                    "field": "Nilai",
                    "description": "Masukkan jumlah nilai pengurangan."
                }
            ],
